{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "reader",
  "description": "Bundled reader commands only",
  "windows": ["reader"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-select-document",
    "allow-reload-document",
    "allow-commit-document",
    "allow-cancel-operation",
    "allow-get-settings",
    "allow-update-settings",
    "allow-resolve-media",
    "allow-activate-link",
    "allow-present-reader"
  ]
}
