# Template only. Copy to .env and fill in the value; .env is gitignored and
# must never be committed. A crates.io API token is created under the account
# that owns the crate, at https://crates.io/settings/tokens.
#
# The publish command reads CARGO_REGISTRY_TOKEN from the environment first
# and from this file second, and passes it only to Cargo.
CARGO_REGISTRY_TOKEN=
