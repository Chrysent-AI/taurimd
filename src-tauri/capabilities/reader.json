{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "reader",
  "description": "Bundled reader commands only",
  "windows": ["reader"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-select-root",
    "allow-refresh-index",
    "allow-get-siblings",
    "allow-read-preview",
    "allow-cancel-preview",
    "allow-open-index-entry",
    "allow-reveal-document",
    "allow-select-document",
    "allow-reload-document",
    "allow-commit-document",
    "allow-cancel-operation",
    "allow-get-settings",
    "allow-update-settings",
    "allow-resolve-media",
    "allow-activate-link",
    "allow-present-reader",
    "allow-begin-export",
    "allow-append-export-image",
    "allow-finish-export",
    "allow-cancel-export"
  ]
}
